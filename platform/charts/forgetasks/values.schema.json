{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgeTasksChartValues",
  "description": "Validation schema for the ForgeTasks application Helm chart values",
  "type": "object",
  "required": [
    "environment",
    "api",
    "postgresql"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "staging"],
      "description": "Deployment environment tier"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "api": {
      "type": "object",
      "required": [
        "replicaCount",
        "image",
        "service",
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$",
              "description": "Immutable container image digest in format sha256:<64-hex> or empty string."
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "required": [
            "type",
            "port"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "springProfilesActive": {
              "type": "string"
            }
          }
        },
        "configMapAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional metadata annotations attached to the API ConfigMap"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|[kMGTPE]i?)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|[kMGTPE]i?)$"
                }
              }
            }
          }
        },
        "probes": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "service",
        "auth",
        "persistence",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "auth": {
          "type": "object",
          "required": [
            "existingSecretName",
            "database",
            "username"
          ],
          "properties": {
            "existingSecretName": {
              "type": "string",
              "minLength": 1
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            }
          },
          "not": {
            "anyOf": [
              { "required": ["password"] },
              { "required": ["postgresPassword"] }
            ]
          }
        },
        "persistence": {
          "type": "object",
          "required": [
            "enabled",
            "accessMode",
            "size"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessMode": {
              "type": "string",
              "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|[kMGTPE]i?)$"
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|[kMGTPE]i?)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|[kMGTPE]i?)$"
                }
              }
            }
          }
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "test": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": { "const": "staging" }
        }
      },
      "then": {
        "properties": {
          "api": {
            "properties": {
              "image": {
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "minLength": 71,
                    "description": "Immutable container image digest in format sha256:<64-hex> is strictly required for staging."
                  }
                },
                "required": ["digest"]
              }
            }
          }
        }
      }
    }
  ]
}
