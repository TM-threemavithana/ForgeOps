# ForgeOps Gate G06 — PostgreSQL Secret Template (Sanitized Example)
# DO NOT COMMIT REAL PASSWORDS TO GIT (Enforces ADR-0006 & AGENTS.md Hard Boundary 5)
# This file is an example template. Real secrets are injected out-of-band by:
#   scripts/cluster/inject-secrets.sh

apiVersion: v1
kind: Secret
metadata:
  name: forgetasks-db-secret
  namespace: forgeops-dev
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: forgeops
    forgeops.dev/environment: dev
type: Opaque
stringData:
  postgres-password: "REPLACE_ME_VIA_INJECT_SECRETS_SCRIPT"
