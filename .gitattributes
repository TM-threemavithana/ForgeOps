# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.sh text eol=lf
*.bash text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tf text eol=lf
*.md text eol=lf
Makefile text eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.tar.gz binary
*.zip binary
