# ForgeOps Gate G02 — Docker Compose Environment Template
# Copy or run `scripts/setup_secrets.sh` to initialize local credentials in secrets/db_password.txt
# DO NOT commit real secrets or credentials to version control.

# Application Configuration
PORT=8080
MANAGEMENT_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Internal Docker Service)
POSTGRES_DB=forgetasks
POSTGRES_USER=forgeuser
# Database password is provided via Docker Secret mounted from secrets/db_password.txt
